---
import { project } from '../data/project.js';
import { TIME_SLOTS } from '../lib/whatsapp.js';
---
<dialog class="modal" id="appointment-dialog" aria-labelledby="appt-title" aria-describedby="appt-desc">
  <div class="modal-head">
    <div>
      <p class="eyebrow">Ziyaret randevusu</p>
      <h2 id="appt-title">Randevu talep et</h2>
    </div>
    <button type="button" class="icon-btn" data-close aria-label="Kapat">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <form class="modal-body" id="appt-form" novalidate>
    <p id="appt-desc" class="fine">Bilgileriniz bu sitede saklanmaz. “WhatsApp üzerinden talep gönder” düğmesi, hazırlanan mesajla WhatsApp’ı açar; mesajı WhatsApp’ta siz gönderirsiniz. Tarih ve saat bir müsaitlik takvimi değil, tercih bilgisidir.</p>
    <div class="field">
      <label for="appt-name">Adınız <span class="opt">(isteğe bağlı)</span></label>
      <input class="input" id="appt-name" name="name" autocomplete="name" maxlength="60" />
    </div>
    <div class="row-2">
      <div class="field">
        <label for="appt-date">Tercih edilen tarih</label>
        <input class="input" id="appt-date" name="date" type="date" required aria-describedby="appt-date-err" />
        <p class="field-error" id="appt-date-err" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="appt-slot">Saat aralığı</label>
        <select class="input" id="appt-slot" name="slot">
          {TIME_SLOTS.map((s, i) => <option value={s} selected={i === 2}>{s}</option>)}
        </select>
      </div>
    </div>
    <div class="field">
      <label for="appt-note">Kısa not <span class="opt">(isteğe bağlı)</span></label>
      <textarea class="input" id="appt-note" name="note" maxlength="300" rows="3"></textarea>
    </div>
    <fieldset class="ctx-box" id="appt-ctx" hidden>
      <legend>Keşifteki seçimleriniz mesaja eklensin mi?</legend>
      <label class="check" data-ctx="floor"><input type="checkbox" name="ctx-floor" checked /> <span></span></label>
      <label class="check" data-ctx="type"><input type="checkbox" name="ctx-type" checked /> <span></span></label>
      <label class="check" data-ctx="amenity"><input type="checkbox" name="ctx-amenity" checked /> <span></span></label>
    </fieldset>
    <details>
      <summary class="fine" style="cursor:pointer">Mesaj önizlemesi</summary>
      <pre class="wa-preview" id="appt-preview" aria-live="off"></pre>
    </details>
    <a class="btn btn-primary" id="appt-send" href={project.contact.whatsappBase} target="_blank" rel="noopener" style="width:100%">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
      WhatsApp üzerinden talep gönder
    </a>
    <p class="wa-status" id="appt-status" role="status" hidden></p>
    <p class="fine" style="margin-top:14px">Telefonla ulaşmak için: <a href={project.contact.phoneHref}>{project.contact.phoneDisplay}</a> · <a href={`mailto:${project.contact.email}`}>{project.contact.email}</a></p>
  </form>
</dialog>

<script>
  import { buildMessage, buildWhatsAppUrl, validateVisitDate, todayIso } from '../lib/whatsapp.js';
  import { project } from '../data/project.js';
  import { safeStorage } from '../lib/storage.js';

  const dlg = document.getElementById('appointment-dialog') as HTMLDialogElement | null;
  if (dlg) {
    const form = dlg.querySelector('#appt-form') as HTMLFormElement;
    const date = dlg.querySelector('#appt-date') as HTMLInputElement;
    const dateErr = dlg.querySelector('#appt-date-err') as HTMLElement;
    const send = dlg.querySelector('#appt-send') as HTMLAnchorElement;
    const preview = dlg.querySelector('#appt-preview') as HTMLElement;
    const status = dlg.querySelector('#appt-status') as HTMLElement;
    const ctxBox = dlg.querySelector('#appt-ctx') as HTMLFieldSetElement;
    const session = safeStorage('session');
    let ctx: { floor?: number | null; typeTitle?: string | null; amenity?: string | null } = {};
    let opener: HTMLElement | null = null;
    let touched = false;

    const today = todayIso();
    date.min = today;

    function readContext(extraAmenity?: string | null) {
      try { ctx = JSON.parse(session.get('incek-baglam') || '{}') || {}; } catch { ctx = {}; }
      if (extraAmenity) ctx.amenity = extraAmenity;
      const rows: [string, string | null][] = [
        ['floor', ctx.floor != null ? `Görsel keşifte baktığım kat: ${ctx.floor}. kat (örnek keşif seçimi)` : null],
        ['type', ctx.typeTitle ? `Örnek daire tipi: ${ctx.typeTitle}` : null],
        ['amenity', ctx.amenity ? `Sosyal alan: ${ctx.amenity}` : null]
      ];
      let any = false;
      for (const [k, text] of rows) {
        const row = ctxBox.querySelector(`[data-ctx="${k}"]`) as HTMLElement;
        row.hidden = !text;
        (row.querySelector('span') as HTMLElement).textContent = text || '';
        (row.querySelector('input') as HTMLInputElement).checked = true;
        if (text) any = true;
      }
      ctxBox.hidden = !any;
    }

    function currentMessage() {
      const fd = new FormData(form);
      const use = (k: string) => fd.get('ctx-' + k) === 'on';
      return buildMessage({
        name: String(fd.get('name') || ''),
        date: String(fd.get('date') || ''),
        slot: String(fd.get('slot') || ''),
        note: String(fd.get('note') || ''),
        context: {
          floor: use('floor') ? ctx.floor ?? null : null,
          typeTitle: use('type') ? ctx.typeTitle ?? null : null,
          amenity: use('amenity') ? ctx.amenity ?? null : null
        }
      });
    }

    function update() {
      const v = validateVisitDate(date.value, today);
      const showErr = touched && !v.ok;
      dateErr.textContent = showErr ? (v as any).error : '';
      date.setAttribute('aria-invalid', showErr ? 'true' : 'false');
      const msg = currentMessage();
      preview.textContent = v.ok ? msg : 'Mesaj, tarih seçildiğinde burada görünür.';
      send.href = v.ok ? buildWhatsAppUrl(project.contact.whatsappNumber, msg) : project.contact.whatsappBase;
      send.setAttribute('aria-disabled', v.ok ? 'false' : 'true');
    }

    form.addEventListener('input', () => { status.hidden = true; update(); });
    date.addEventListener('blur', () => { touched = true; update(); });
    form.addEventListener('submit', (e) => e.preventDefault());

    send.addEventListener('click', (e) => {
      touched = true;
      update();
      if (send.getAttribute('aria-disabled') === 'true') {
        e.preventDefault();
        date.focus();
        return;
      }
      // Bağlantı yeni sekmede WhatsApp'ı açar. Mesaj otomatik gönderilmez; onay mesajı gösterilmez.
      status.hidden = false;
      status.textContent = 'WhatsApp yeni sekmede açılıyor. Talebinizin iletilmesi için mesajı WhatsApp’ta göndermeniz gerekir.';
    });

    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { opener?.focus?.(); opener = null; });

    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-open-appointment]') as HTMLElement | null;
      if (!t) return;
      e.preventDefault();
      opener = t;
      readContext(t.dataset.amenity || null);
      touched = false;
      status.hidden = true;
      update();
      dlg.showModal();
      (dlg.querySelector('#appt-name') as HTMLInputElement).focus();
    });
  }
</script>
